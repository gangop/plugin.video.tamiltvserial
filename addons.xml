<?xml version="1.0" encoding="UTF-8"?>
<addons><addon id="plugin.video.tamiltvserial" name="Tamil TV Serial" version="1.1.55" provider-name="TV Clone">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
        <import addon="inputstream.adaptive" version="2.0.0" optional="true" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" start="startup" />
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Browse and stream Tamil TV serials from TamilTvSerial.com</summary>
        <description lang="en_GB">Watch Sun TV, Vijay TV, Zee Tamil serials and Tamil TV shows. Browse by channel or serial, search episodes, play the latest updates, and watch Live TV channels.</description>
        <disclaimer lang="en_GB">This addon is not affiliated with TamilTvSerial.com, TamilRadios.org, or any TV broadcaster. Content availability depends on the source website.</disclaimer>
        <platform>all</platform>
        <language>ta en</language>
        <license>GPL-3.0-or-later</license>
        <assets>
            <icon>resources/icon.png</icon>
        </assets>
    </extension>
</addon><addon id="repository.tamiltvserial" name="Tamil TV Serial Repository" version="1.0.8" provider-name="TV Clone">
    <extension point="xbmc.addon.repository" name="Tamil TV Serial Repository">
        
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/gangop/plugin.video.tamiltvserial/main/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/gangop/plugin.video.tamiltvserial/main/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/gangop/plugin.video.tamiltvserial/main/zips/</datadir>
            <hashes>false</hashes>
        </dir>
        <dir>
            <info compressed="false">https://cdn.jsdelivr.net/gh/gangop/plugin.video.tamiltvserial@main/addons.xml</info>
            <checksum>https://cdn.jsdelivr.net/gh/gangop/plugin.video.tamiltvserial@main/addons.xml.checksum</checksum>
            <datadir zip="true">https://cdn.jsdelivr.net/gh/gangop/plugin.video.tamiltvserial@main/zips/</datadir>
            <hashes>false</hashes>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Auto-updates for Tamil TV Serial addon</summary>
        <description lang="en_GB">Install this repository once to receive automatic updates for the Tamil TV Serial Kodi video addon.</description>
        <disclaimer lang="en_GB">This repository is not affiliated with TamilTvSerial.com or any TV broadcaster.</disclaimer>
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
        <assets>
            <icon>resources/icon.png</icon>
        </assets>
    </extension>
</addon></addons>
